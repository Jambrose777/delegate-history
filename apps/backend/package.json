  },
  "dependencies": {
    "@delegate-history/shared": "workspace:*",
    "better-sqlite3": "13.1.1",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-openapi-validator": "5.6.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
